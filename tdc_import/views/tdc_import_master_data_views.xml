<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Port -->
    <record id="view_tdc_port_list" model="ir.ui.view">
        <field name="name">tdc.port.list</field>
        <field name="model">tdc.port</field>
        <field name="arch" type="xml">
            <list><field name="name"/></list>
        </field>
    </record>
    <record id="view_tdc_port_form" model="ir.ui.view">
        <field name="name">tdc.port.form</field>
        <field name="model">tdc.port</field>
        <field name="arch" type="xml">
            <form><sheet><group><field name="name"/></group></sheet></form>
        </field>
    </record>
    <record id="action_tdc_port" model="ir.actions.act_window">
        <field name="name">Ports</field>
        <field name="res_model">tdc.port</field>
        <field name="view_mode">list,form</field>
    </record>

