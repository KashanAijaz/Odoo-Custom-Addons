<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List/Tree View -->
    <record id="view_tdc_currency_tree" model="ir.ui.view">
        <field name="name">tdc.currency.tree</field>
        <field name="model">tdc.currency</field>
        <field name="arch" type="xml">
            <list string="Currencies">
                <field name="name"/>
                <field name="symbol"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_tdc_currency_form" model="ir.ui.view">
        <field name="name">tdc.currency.form</field>
        <field name="model">tdc.currency</field>
        <field name="arch" type="xml">
            <form string="Currency">
                <sheet>
                    <group>
                        <group>
                            <field name="name" placeholder="Currency Name"/>
                        </group>
                        <group>
                            <field name="symbol" placeholder="Symbol"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_tdc_currency" model="ir.actions.act_window">
        <field name="name">Currencies</field>
        <field name="res_model">tdc.currency</field>
        <field name="view_mode">list,form</field>
    </record>

    
    
  
</odoo>