    <!-- Action -->
    <record id="action_tdc_import_tariff" model="ir.actions.act_window">
        <field name="name">Tariff</field>
        <field name="res_model">tdc.import.tariff</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Import GD Tariff record
            </p>
            <p>
                Record the GD No., vendor, currency of import, exchange rate and add
                tariff lines to automatically compute CD, RD, ACD, ST, AST, IT and the
                total sum payable in PKR.
            </p>
        </field>
    </record>

    <!-- Menus -->
    <menuitem id="menu_tdc_import_root" name="Import" sequence="60"/>
    <menuitem id="menu_tdc_import_tariff" name="Tariff" parent="menu_tdc_import_root"
              action="action_tdc_import_tariff" sequence="10"/>
    <menuitem id="menu_tdc_import_configuration" name="Configuration" parent="menu_tdc_import_root" sequence="90"/>

</odoo>
