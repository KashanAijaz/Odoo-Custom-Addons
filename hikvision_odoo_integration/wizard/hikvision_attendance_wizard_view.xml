<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="hikvision_attendance_wizard_view_form" model="ir.ui.view">
        <field name="name">hikvision.attendance.wizard.view.form</field>
        <field name="model">hikvision.attendance.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="device_id" invisible="1"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                </group>
                <footer>
                    <button name="action_download" string="Download"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hikvision_attendance_wizard" model="ir.actions.act_window">
        <field name="name">Download All Attendance</field>
        <field name="res_model">hikvision.attendance.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>