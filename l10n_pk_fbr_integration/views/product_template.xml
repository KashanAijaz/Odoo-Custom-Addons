<odoo>

    <record id="view_product_form_inherit_hs_code" model="ir.ui.view">
        <field name="name">product.product.form.inherit.hs.code</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='barcode']" position="after">
                <field name="hs_code"/>
                <field name="hs_unit_measure"/>
            </xpath>
        </field>
    </record>

    <record id="view_product_template_form_inherit_hs_code" model="ir.ui.view">
        <field name="name">product.template.form.inherit.hs.code</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='barcode']" position="after">
                <field name="hs_code"/>
                <field name="hs_unit_measure"/>
            </xpath>
        </field>
    </record>

</odoo>
