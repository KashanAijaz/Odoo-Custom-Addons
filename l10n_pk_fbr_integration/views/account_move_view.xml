<!-- l10n_pk_fbr_integration/views/account_move_view.xml -->
<odoo>
    <record id="view_move_form_inherit_fbr" model="ir.ui.view">
        <field name="name">account.move.form.inherit.fbr</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_sync_with_fbr" type="object" class="btn-primary"
                        string="Sync with FBR"/>

            </xpath>

            <xpath expr="//notebook" position="inside">
                <page name="FBR Integration" string="FBR Integration">
                    <group>
                        <group>
                            <field name="fbr_synced" readonly="1"/>
                            <field name="fbr_response" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
