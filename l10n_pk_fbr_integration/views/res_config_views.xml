<!-- l10n_pk_fbr_integration/views/res_config_views.xml -->
<odoo>
    <record id="res_config_settings_view_inherit_fbr" model="ir.ui.view">
        <field name="name">res.config.settings.view.inherit.l10n_pk_fbr</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <form position="inside">
                <group string="FBR Integration">
                    <field name="fbr_api_url"
                           placeholder="https://esp.fbr.gov.pk:8244/DigitalInvoicing/v1/PostInvoiceData_v1"/>
                    <field name="fbr_security_token" password="True"/>
                    <field name="fbr_cookie_string"/>
                    <field name="fbr_sandbox_mode"/>
                </group>
            </form>
        </field>
    </record>
</odoo>