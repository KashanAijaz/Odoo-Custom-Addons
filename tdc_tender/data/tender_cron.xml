<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_tender_due_reminder" model="ir.cron">
            <field name="name">Upcoming Tender: Due Date Reminder</field>
            <field name="model_id" ref="model_tdc_upcoming_tender"/>
            <field name="state">code</field>
            <field name="code">model._cron_due_reminder()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
        
        <record id="ir_cron_earnest_validity_reminder" model="ir.cron">
            <field name="name">Earnest Money: Validity Reminder</field>
            <field name="model_id" ref="model_tdc_earnest_money"/>
            <field name="state">code</field>
            <field name="code">model._cron_validity_reminder()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_pbond_validity_reminder" model="ir.cron">
            <field name="name">Performance Bond: Validity Reminder</field>
            <field name="model_id" ref="model_tdc_performance_bond"/>
            <field name="state">code</field>
            <field name="code">model._cron_validity_reminder()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>