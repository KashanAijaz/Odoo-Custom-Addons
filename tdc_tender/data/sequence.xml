<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="seq_working_sheet" model="ir.sequence">
        <field name="name">Working Sheet</field>
        <field name="code">tdc.working.sheet</field>
        <field name="prefix">WS/</field>
        <field name="padding">5</field>
    </record>

    <record id="seq_upcoming_tender" model="ir.sequence">
        <field name="name">Upcoming Tender</field>
        <field name="code">tdc.upcoming.tender</field>
        <field name="padding">4</field>
        <field name="number_increment">1</field>
        <field name="implementation">no_gap</field>
    </record>

    <record id="seq_tdc_earnest_money" model="ir.sequence">
        <field name="name">Earnest Money Sequence</field>
        <field name="code">tdc.earnest.money</field>
        <field name="prefix">EM/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
    



</odoo>