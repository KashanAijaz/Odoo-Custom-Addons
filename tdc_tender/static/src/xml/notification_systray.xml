<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="tdc_tender.NotificationSystray">

    <div class="o_tdc_notification_systray"
         t-ref="root"
         style="position:relative;display:flex;align-items:center;height:100%;">

        <!-- Bell -->
        <div t-on-click="toggle"
             title="Notifications"
             style="
                position:relative;
                display:flex;
                align-items:center;
                justify-content:center;
                width:40px;
                height:40px;
                cursor:pointer;
                border-radius:50%;
                transition:all .2s ease;
             "
             onmouseover="this.style.background='rgba(255,255,255,.12)'"
             onmouseout="this.style.background='transparent'">

            <i class="fa fa-bell"
               style="font-size:18px;color:#ffffff;"></i>

            <span t-if="state.count > 0"
                  style="
                    position:absolute;
                    top:5px;
                    right:5px;
                    min-width:18px;
                    height:18px;
                    border-radius:50%;
                    background:#e53935;
                    color:#fff;
                    font-size:10px;
                    font-weight:600;
                    display:flex;
                    align-items:center;
                    justify-content:center;
                    border:2px solid white;
                    box-shadow:0 2px 6px rgba(0,0,0,.2);
                  ">
                <t t-esc="state.count"/>
            </span>

        </div>


        <!-- Dropdown -->
        <div t-if="state.open"
             style="
                position:absolute;
                top:48px;
                right:0;
                width:360px;
                background:#fff;
                border-radius:10px;
                overflow:hidden;
                box-shadow:0 10px 30px rgba(0,0,0,.18);
                border:1px solid #e6e6e6;
                z-index:9999;
                animation:fadeIn .18s ease;
             ">

            <!-- Header -->
            <div style="
                padding:14px 16px;
                border-bottom:1px solid #ececec;
                font-size:15px;
                font-weight:600;
                background:#fafafa;
            ">
                🔔 Notifications
            </div>


            <!-- Empty -->
            <t t-if="state.notifications.length === 0">
                <div style="
                    padding:35px 20px;
                    text-align:center;
                    color:#8c8c8c;
                    font-size:13px;
                ">
                    No unread notifications
                </div>
            </t>


            <!-- Notification List -->
            <div style="max-height:330px;overflow-y:auto;">

                <t t-foreach="state.notifications"
                   t-as="notif"
                   t-key="notif.id">

                    <div t-on-click="() => this.openNotification(notif.id)"
                         style="
                            padding:14px 16px;
                            cursor:pointer;
                            border-bottom:1px solid #f3f3f3;
                            transition:background .2s;
                         "
                         onmouseover="this.style.background='#f7f9fc'"
                         onmouseout="this.style.background='white'">

                        <div style="
                            font-weight:600;
                            color:#343a40;
                            margin-bottom:4px;
                            white-space:nowrap;
                            overflow:hidden;
                            text-overflow:ellipsis;
                        ">
                            <t t-esc="notif.name"/>
                        </div>

                        <div style="
                            font-size:13px;
                            color:#6c757d;
                            overflow:hidden;
                            text-overflow:ellipsis;
                            display:-webkit-box;
                            -webkit-line-clamp:2;
                            -webkit-box-orient:vertical;
                        ">
                            <t t-esc="notif.message"/>
                        </div>

                    </div>

                </t>

            </div>


            <!-- Footer -->
            <div style="
                padding:12px;
                border-top:1px solid #ececec;
                background:#fafafa;
            ">

                <button class="btn btn-primary w-100"
                        style="
                            border-radius:6px;
                            font-weight:500;
                        "
                        t-on-click="viewDetail">

                    View All Notifications

                </button>

            </div>

        </div>

    </div>

</t>

</templates>