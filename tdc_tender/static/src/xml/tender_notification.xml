<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="tdc_tender.TenderNotificationSystray">
        <div class="o_nav_entry tdc_notif">
            <Dropdown state="dropdown"
                      position="'bottom-end'"
                      menuClass="'tdc_notif_menu p-0'">

                <button class="btn tdc_notif_btn border-0" title="Tender Notifications">
                    <i class="fa fa-bell fa-fw"/>
                    <span t-if="state.items.length"
                          class="badge rounded-pill text-bg-danger tdc_notif_badge"
                          t-esc="state.items.length"/>
                </button>

                <t t-set-slot="content">
                    <div class="tdc_notif_header">
                        <span>Tender Notifications</span>
                        <button class="btn btn-sm border-0 tdc_notif_close"
                                title="Close" t-on-click="closeMenu">
                            <i class="fa fa-times"/>
                        </button>
                    </div>

                    <div t-if="!state.items.length" class="p-3 text-muted text-center">
                        No upcoming deadlines
                    </div>

                    <div t-foreach="state.items" t-as="n" t-key="n.model + '-' + n.id"
                         t-attf-class="tdc_notif_item tdc_prio_{{n.priority}}"
                         t-on-click="() => this.openTender(n)">

                        <div class="d-flex justify-content-between align-items-center">
                            <strong t-esc="n.name"/>
                            <span class="badge tdc_prio_badge" t-esc="n.priority_label"/>
                        </div>
                        <div class="text-truncate" t-esc="n.tender_title"/>
                        <div class="small text-muted text-truncate" t-esc="n.partner"/>
                        <div class="small fw-bold tdc_due">
                            <i class="fa fa-clock-o me-1"/>
                            <t t-esc="n.message"/> (<t t-esc="n.due_date"/>)
                        </div>
                    </div>

                    <div class="tdc_notif_footer" t-on-click="viewAll">
                        View All Notifications
                    </div>
                </t>
            </Dropdown>

            <button t-if="state.activeCount > 1"
                    class="tdc_clear_all_btn"
                    t-on-click="clearAllToasts">
                Clear All (<t t-esc="state.activeCount"/>)
            </button>
        </div>
    </t>

</templates>