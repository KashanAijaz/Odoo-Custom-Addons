<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_technical_quotation">

        <t t-call="web.html_container">

            <t t-foreach="docs" t-as="doc">

                <t t-call="web.external_layout">

                    <!-- First Sale Order Against Tender -->
                    <t t-set="sale_order" t-value="doc.sale_order_ids[:1]"/>

                    <div class="page">

                        <!-- ================= HEADER ================= -->

                        <table style="width:100%; font-size:13px; border-collapse:collapse;">

                            <tr>

                                <td style="width:60%; vertical-align:top;">

                                    <strong>Attn.</strong><br/>

                                    <span t-esc="doc.upcoming_tender_id.partner_id.name"/>

                                </td>

                                <td style="width:40%;">

                                    <table style="width:100%;">

                                        <tr>
                                            <td><b>Date</b></td>
                                            <td>
                                                <span t-field="doc.create_date"
                                                      t-options='{"widget":"date"}'/>
                                            </td>
                                        </tr>

                                        <tr>
                                            <td><b>Validity</b></td>
                                            <td>
                                                <p>30days</p>
                                            </td>
                                        </tr>

                                        <tr>
                                            <td><b>Quote No.</b></td>
                                            <td>
                                                <span t-field="doc.name"/>
                                            </td>
                                        </tr>

                                        <tr>
                                            <td><b>Reference</b></td>
                                            <td>
                                                <span t-esc="doc.upcoming_tender_id.tender_ref_note"/>
                                            </td>
                                        </tr>

                                    </table>

                                </td>

                            </tr>

                        </table>

                        <br/>

                        <div style="text-align:center;
                                    border-top:2px solid black;
                                    border-bottom:2px solid black;
                                    margin-bottom:15px;">

                            <h3>TECHNICAL QUOTATION</h3>

                        </div>
                        <div style="margin-top:15px; margin-bottom:10px;">
                            <strong>
                                <span t-esc="doc.upcoming_tender_id.tender_title"/>
                            </strong>
                        </div>
                        <p>

                            Dear Correspondent,

                            <br/><br/>

                            In response to your inquiry, we would like to offer our quotation in compliance with your tender requirements.

                        </p>

                        <!-- ================= TABLE ================= -->

                        <table border="1"
                               style="width:100%;
                                      border-collapse:collapse;
                                      font-size:12px;">

                            <thead>

                                <tr style="background:#d9e3f0;">

                                    <th style="width:5%; text-align:center;">S.#</th>

                                    <th style="width:85%; text-align:center;">
                                        DESCRIPTION OF ITEMS (QUOTED SPECIFICATIONS)
                                    </th>

                                    <th style="width:10%; text-align:center;">
                                        QTY
                                    </th>

                                </tr>

                            </thead>
                            
                           <tbody>
                                <t t-foreach="sale_order.order_line" t-as="line">
                                    <t t-if="not line.display_type">
                                    <tr>

                                        <td style="text-align:center; vertical-align:top;">
                                            <span t-esc="line_index + 1"/>
                                        </td>

                                       <td style="padding:8px;">

                                            <strong>
                                                <span t-field="line.product_id"/>
                                            </strong>

                                            <br/><br/>

                                            <b>Model :</b>
                                            <span t-field="line.product_id.product_tmpl_id.model_no_id"/>
                                            <br/>

                                            <b>MAKE :</b>
                                            <span t-field="line.product_id.product_tmpl_id.tender_make"/>
                                           
                                            <br/>
                                            <t t-if="line.product_id.product_tmpl_id.sku">
                                                <b>PART NO:</b>
                                                <span t-field="line.product_id.product_tmpl_id.sku"/>
                                            </t>
                                            <br/>
                                            <t t-if="line.product_id.product_tmpl_id.country_of_origin">
                                                <b>Country Of Origin:</b>
                                                <span t-field="line.product_id.product_tmpl_id.country_of_origin"/>
                                            </t>
                                                                                    
                                                                                        <br/><br/>

                                            <t t-if="line.technical_key_features">
                                                <b>Key Features</b>
                                                <div t-field="line.technical_key_features"/>
                                                <br/>
                                            </t>

                                            <t t-if="line.tender_specification">
                                                <b>Technical Specification</b>
                                                <div t-field="line.tender_specification"/>
                                                <br/>
                                            </t>

                                            <!-- <t t-if="line.technical_power_supply">
                                                <b>Power Supply</b>
                                                <div t-field="line.technical_power_supply"/>
                                            </t> -->

                                        </td>
                                        <td style="text-align:center; vertical-align:top;">
                                            <span t-field="line.product_uom_qty"/>
                                        </td>

                                    </tr>
                                    </t>
                                </t>
                            </tbody>
                        </table>

                        <br/><br/>

                        <!-- ================= TERMS ================= -->

                        <t t-if="sale_order and sale_order.technical_terms">

                            <h4 style="text-align:center;">
                                TERMS &amp; CONDITIONS
                            </h4>

                            <div t-field="sale_order.technical_terms"/>

                        </t>

                    </div>

                </t>

            </t>

        </t>

    </template>

</odoo>