<?xml version="1.0" encoding="utf-8"?>
<odoo>

        <template id="report_techno_financial_quotation">

        <t t-call="web.html_container">

        <t t-foreach="docs" t-as="doc">

        <t t-call="web.external_layout">

        <t t-set="sale_order" t-value="doc"/>
        <t t-set="is_cnf" t-value="sale_order.order_line and any(l.is_cnf for l in sale_order.order_line)"/>

        <div class="page">

        <!-- ================= HEADER ================= -->

        <table style="width:100%;font-size:13px;border-collapse:collapse;">

        <tr>

        <td style="width:60%;vertical-align:top;">

        <b>Attn.</b><br/>

        <span t-esc="sale_order.upcoming_tender_id.partner_id.name"/>

        </td>

        <td style="width:40%;">

        <table style="width:100%;">

        <tr>
        <td><b>Date</b></td>
        <td>
        <span t-field="sale_order.create_date"
        t-options='{"widget":"date"}'/>
        </td>
        </tr>

        <tr>
        <td><b>Validity</b></td>
        <td>120 Days</td>
        </tr>

        <tr>
        <td><b>Quote No.</b></td>
        <td>
        <span t-field="sale_order.name"/>
        </td>
        </tr>

        <tr>
        <td><b>Reference</b></td>
        <td>
        <span t-esc="sale_order.upcoming_tender_id.tender_title"/>
        </td>
        </tr>

        </table>

        </td>

        </tr>

        </table>

        <br/>

        <div style="border-top:2px solid #000;border-bottom:2px solid #000;padding:8px;text-align:center;">

        <h3 style="margin:0;">
        TECHNO FINANCIAL QUOTATION
        </h3>

        </div>

        <br/>

        <p>

        Dear Sir,

        <br/><br/>

        We thank you for providing us the opportunity to participate in your tender.
        We are pleased to submit our Techno Financial Quotation as under.

        </p>

        <br/>

        <!-- ================= TABLE : CNF VERSION ================= -->

        <t t-if="is_cnf">

        <table border="1"
        style="width:100%;
        border-collapse:collapse;
        font-size:11px;">

        <thead>

        <tr style="background:#D9EAD3;">

        <th style="width:5%;text-align:center;">
        S#
        </th>

        <th style="width:51%;text-align:center;">
        DESCRIPTION OF ITEMS
        </th>

        <th style="width:7%;text-align:center;">
        QTY
        </th>

        <th style="width:16%;text-align:center;">
        UNIT PRICE
        </th>

        <th style="width:16%;text-align:center;">
        TOTAL AMOUNT
        </th>

        </tr>

        </thead>

       <tbody>
    <t t-set="order_lines" t-value="sale_order.order_line.filtered(lambda l: not l.display_type)"/>

    <t t-foreach="sale_order.worksheet_id.line_ids" t-as="line">
        <t t-set="ol" t-value="order_lines.filtered(lambda l: l.product_id == line.product_id)[:1]"/>

        <tr>
            <td style="vertical-align:top;text-align:center;">
                <span t-field="line.sequence"/>
            </td>

            <td style="padding:8px;">
                <strong>
                    <span t-field="line.product_id"/>
                </strong>

                <br/><br/>

                <b>MODEL :</b>
                <span t-field="line.product_id.product_tmpl_id.model_no_id"/>
                <br/>

                <b>PART NO:</b>
                <span t-field="line.product_id.product_tmpl_id.sku"/>

                <b>MAKE :</b>
                <span t-field="line.product_id.product_tmpl_id.tender_make"/>

                <t t-if="ol and ol.technical_key_features">
                    <br/><br/>
                    <b>Key Features</b>
                    <div t-field="ol.technical_key_features"/>
                </t>

                <t t-if="ol and ol.tender_specification">
                    <br/>
                    <b>Technical Specification</b>
                    <div t-field="ol.tender_specification"/>
                </t>
            </td>

            <td style="text-align:center;vertical-align:top;">
                <span t-field="line.qty"/>
            </td>

            <td style="text-align:right;vertical-align:top;">
                <span t-field="line.unit_cnf_at_site"
                      t-options='{"widget":"float","precision":2}'/>
            </td>

            <td style="text-align:right;vertical-align:top;">
                <span t-field="line.total_cnf_at_site"
                      t-options='{"widget":"float","precision":2}'/>
            </td>
        </tr>
    </t>

    <!-- Grand Total -->

    <tr style="background:#D9EAD3;">

        <td colspan="3" style="text-align:right;">
            <b>Grand Total</b>
        </td>

        <td style="text-align:right;">
            <strong>
                <span t-esc="sum(sale_order.worksheet_id.line_ids.mapped('unit_cnf_at_site'))"/>
            </strong>
        </td>

        <td style="text-align:right;">
            <strong>
                <span t-esc="sum(sale_order.worksheet_id.line_ids.mapped('total_cnf_at_site'))"/>
            </strong>
        </td>

    </tr>

</tbody>

        </table>

        </t>

        <!-- ================= TABLE : NORMAL VERSION (with GST) ================= -->

        <t t-else="">

        <table border="1"
        style="width:100%;
        border-collapse:collapse;
        font-size:11px;">

        <thead>

        <tr style="background:#D9EAD3;">

        <th style="width:5%;text-align:center;">
        S#
        </th>

        <th style="width:45%;text-align:center;">
        DESCRIPTION OF ITEMS
        </th>

        <th style="width:6%;text-align:center;">
        QTY
        </th>

        <th style="width:11%;text-align:center;">
        UNIT PRICE
        (EX GST)
        </th>

        <th style="width:11%;text-align:center;">
        TOTAL
        (EX GST)
        </th>

        <th style="width:10%;text-align:center;">
        GST
        </th>

        <th style="width:12%;text-align:center;">
        TOTAL
        (INC GST)
        </th>

        </tr>

        </thead>

       <tbody>
    <t t-set="order_lines" t-value="sale_order.order_line.filtered(lambda l: not l.display_type)"/>

    <t t-foreach="sale_order.worksheet_id.line_ids" t-as="line">
        <t t-set="ol" t-value="order_lines.filtered(lambda l: l.product_id == line.product_id)[:1]"/>

        <tr>
            <td style="vertical-align:top;text-align:center;">
                <span t-field="line.sequence"/>
            </td>

            <td style="padding:8px;">
                <strong>
                    <span t-field="line.product_id"/>
                </strong>

                <br/><br/>

                <b>MODEL :</b>
                <span t-field="line.product_id.product_tmpl_id.model_no_id"/>
                <br/>

                <b>PART NO:</b>
                <span t-field="line.product_id.product_tmpl_id.sku"/>

                <b>MAKE :</b>
                <span t-field="line.product_id.product_tmpl_id.tender_make"/>

                <t t-if="ol and ol.technical_key_features">
                    <br/><br/>
                    <b>Key Features</b>
                    <div t-field="ol.technical_key_features"/>
                </t>

                <t t-if="ol and ol.tender_specification">
                    <br/>
                    <b>Technical Specification</b>
                    <div t-field="ol.tender_specification"/>
                </t>
            </td>

            <td style="text-align:center;vertical-align:top;">
                <span t-field="line.qty"/>
            </td>

            <td style="text-align:right;vertical-align:top;">
                <span t-field="line.unit_ex_gst_corrected"/>
            </td>

            <td style="text-align:right;vertical-align:top;">
                <span t-field="line.total_ex_gst"/>
            </td>

            <td style="text-align:right;vertical-align:top;">
                <span t-field="line.gst_amount"/>
            </td>

            <td style="text-align:right;vertical-align:top;">
                <span t-field="line.total_inc_gst"/>
            </td>
        </tr>
    </t>
</tbody>

        </table>

        </t>

        <br/><br/>

                                <!-- ================= GRAND TOTAL SUMMARY ================= -->

                                <t t-if="is_cnf">

                                <t t-set="grand_total_cnf"
                                t-value="sum(sale_order.worksheet_id.line_ids.mapped('total_cnf_at_site'))"/>

                                <table style="width:100%;
                                            margin-top:10px;
                                            border-collapse:collapse;"
                                    border="1">

                                    <tr style="background:#D9EAD3;">

                                        <td style="width:76%;border:none;"></td>

                                        <td style="width:24%;text-align:right;">
                                            <b>Grand Total</b>
                                        </td>

                                        <td style="text-align:right;">
                                            <b>
                                                <span t-esc="grand_total_cnf"/>
                                            </b>
                                        </td>

                                    </tr>

                                </table>

                                </t>

                                <t t-else="">

                                <t t-set="grand_ex_gst"
                                t-value="sum(sale_order.worksheet_id.line_ids.mapped('total_ex_gst'))"/>

                                <t t-set="grand_gst"
                                t-value="sum(sale_order.worksheet_id.line_ids.mapped('gst_amount'))"/>

                                <t t-set="grand_total"
                                t-value="sum(sale_order.worksheet_id.line_ids.mapped('total_inc_gst'))"/>

                                <table style="width:100%;
                                            margin-top:10px;
                                            border-collapse:collapse;"
                                    border="1">

                                    <tr>

                                        <td style="width:56%;border:none;"></td>

                                        <td style="width:20%;text-align:right;">
                                            <b>Total Ex GST</b>
                                        </td>

                                        <td style="width:24%;text-align:right;">
                                            <span t-esc="grand_ex_gst"/>
                                        </td>

                                    </tr>

                                    <tr>

                                        <td style="border:none;"></td>

                                        <td style="text-align:right;">
                                            <b>GST @18%</b>
                                        </td>

                                        <td style="text-align:right;">
                                            <span t-esc="grand_gst"/>
                                        </td>

                                    </tr>

                                    <tr style="background:#D9EAD3;">

                                        <td style="border:none;"></td>

                                        <td style="text-align:right;">
                                            <b>Grand Total</b>
                                        </td>

                                        <td style="text-align:right;">
                                            <b>
                                                <span t-esc="grand_total"/>
                                            </b>
                                        </td>

                                    </tr>

                                </table>

                                </t>

                                <br/><br/>

                                <t t-if="sale_order and sale_order.techno_financial_terms">

                                    <h4>
                                        TERMS &amp; CONDITIONS
                                    </h4>

                                    <div t-field="sale_order.techno_financial_terms"/>

                                </t>

                                <br/><br/>

                            </div>

                        </t>

                    </t>

                </t>

            </template>
</odoo>