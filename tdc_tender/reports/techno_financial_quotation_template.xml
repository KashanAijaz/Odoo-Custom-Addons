<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_techno_financial_quotation">

        <t t-call="web.html_container">

            <t t-foreach="docs" t-as="doc">

                <t t-call="web.external_layout">

                    <t t-set="sale_order" t-value="doc"/>
                    <t t-set="is_cnf" t-value="sale_order.order_line and any(l.is_cnf for l in sale_order.order_line)"/>

                    <div class="page" style="font-family: Arial, Helvetica, sans-serif; color:#222;">

                        <!-- ================= HEADER ================= -->

                        <table style="width:100%; font-size:14px; border-collapse:collapse; margin-bottom:10px;">

                            <tr>

                                <td style="width:60%; vertical-align:top;">

                                    <div style="font-size:13px; font-weight:bold; text-transform:uppercase; color:#555; letter-spacing:0.5px; margin-bottom:4px;">
                                        Attn.
                                    </div>

                                    <div style="font-size:18px; font-weight:bold; color:#1a1a1a;">
                                        <span t-esc="sale_order.upcoming_tender_id.partner_id.name"/>
                                    </div>

                                </td>

                                <td style="width:40%;">

                                    <table style="width:100%; border-collapse:collapse;">

                                        <tr>
                                            <td style="padding:3px 0; font-size:14px; font-weight:bold; color:#555;">Date</td>
                                            <td style="padding:3px 0; font-size:14px;">
                                                <span t-field="sale_order.create_date"
                                                      t-options='{"widget":"date"}'/>
                                            </td>
                                        </tr>

                                        <tr>
                                            <td style="padding:3px 0; font-size:14px; font-weight:bold; color:#555;">Validity</td>
                                            <td style="padding:3px 0; font-size:14px;">120 Days</td>
                                        </tr>

                                        <tr>
                                            <td style="padding:3px 0; font-size:14px; font-weight:bold; color:#555;">Quote No.</td>
                                            <td style="padding:3px 0; font-size:14px;">
                                                <span t-field="sale_order.name"/>
                                            </td>
                                        </tr>

                                        <tr>
                                            <td style="padding:3px 0; font-size:14px; font-weight:bold; color:#555;">Reference</td>
                                            <td style="padding:3px 0; font-size:14px;">
                                                <span t-esc="sale_order.upcoming_tender_id.tender_title"/>
                                            </td>
                                        </tr>

                                    </table>

                                </td>

                            </tr>

                        </table>

                        <div style="text-align:center;
                                    background:#1a1a1a;
                                    padding:8px 0;
                                    margin-bottom:15px;">

                            <h3 style="font-weight:bold; font-size:22px; color:#ffffff; letter-spacing:1px; margin:0;">
                                TECHNO FINANCIAL QUOTATION
                            </h3>

                        </div>

                        <p style="font-size:14px; line-height:1.5;">

                            Dear Sir,

                            <br/><br/>

                            We thank you for providing us the opportunity to participate in your tender.
                            We are pleased to submit our Techno Financial Quotation as under.

                        </p>

                        <!-- ================= TABLE : CNF VERSION ================= -->

                        <t t-if="is_cnf">

                        <table border="1"
                               style="width:100%;
                                      border-collapse:collapse;
                                      font-size:13px;
                                      border:1px solid #999;">

                            <thead>

                                <tr style="background:#1a1a1a;">

                                    <th style="width:5%; text-align:center; font-size:14px; font-weight:bold; color:#ffffff; padding:8px 4px;">
                                        S#
                                    </th>

                                    <th style="width:51%; text-align:center; font-size:14px; font-weight:bold; color:#ffffff; padding:8px 4px;">
                                        DESCRIPTION OF ITEMS
                                    </th>

                                    <th style="width:7%; text-align:center; font-size:14px; font-weight:bold; color:#ffffff; padding:8px 4px;">
                                        QTY
                                    </th>

                                    <th style="width:16%; text-align:center; font-size:14px; font-weight:bold; color:#ffffff; padding:8px 4px;">
                                        UNIT PRICE
                                    </th>

                                    <th style="width:16%; text-align:center; font-size:14px; font-weight:bold; color:#ffffff; padding:8px 4px;">
                                        TOTAL AMOUNT
                                    </th>

                                </tr>

                            </thead>

                            <tbody>
                                <t t-set="order_lines" t-value="sale_order.order_line.filtered(lambda l: not l.display_type)"/>

                                <t t-foreach="sale_order.worksheet_id.line_ids" t-as="line">
                                    <t t-set="ol" t-value="order_lines.filtered(lambda l: l.product_id == line.product_id)[:1]"/>

                                    <tr>
                                        <td style="text-align:center; vertical-align:top; font-size:14px; font-weight:bold; border:1px solid #ccc;">
                                            <span t-field="line.sequence"/>
                                        </td>

                                        <td style="padding:10px; border:1px solid #ccc;">

                                            <div style="font-size:16px; font-weight:bold; color:#1a1a1a; margin-bottom:6px; text-decoration:underline;">
                                                <span t-field="line.product_id"/>
                                            </div>

                                            <table style="width:100%; border-collapse:collapse; margin-bottom:6px; border:1px solid #999;">
                                                <tr>
                                                    <td style="width:35%; font-size:13px; font-weight:bold; color:#444; padding:5px 8px; background:#f2f2f2; border:1px solid #999;">Model :</td>
                                                    <td style="font-size:13px; padding:5px 8px; border:1px solid #999;">
                                                        <span t-field="line.product_id.product_tmpl_id.model_no_id"/>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td style="width:35%; font-size:13px; font-weight:bold; color:#444; padding:5px 8px; background:#f2f2f2; border:1px solid #999;">Part No. :</td>
                                                    <td style="font-size:13px; padding:5px 8px; border:1px solid #999;">
                                                        <span t-field="line.product_id.product_tmpl_id.sku"/>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td style="width:35%; font-size:13px; font-weight:bold; color:#444; padding:5px 8px; background:#f2f2f2; border:1px solid #999;">Make :</td>
                                                    <td style="font-size:13px; padding:5px 8px; border:1px solid #999;">
                                                        <span t-field="line.product_id.product_tmpl_id.tender_make"/>
                                                    </td>
                                                </tr>
                                            </table>

                                            <t t-if="ol and ol.technical_key_features">
                                                <div style="font-size:14px; font-weight:bold; color:#1a1a1a; background:#f2f2f2; padding:4px 6px; margin-top:8px; margin-bottom:4px;">
                                                    Key Features
                                                </div>
                                                <div t-field="ol.technical_key_features" style="font-size:13px; line-height:1.4;"/>
                                            </t>

                                            <t t-if="ol and ol.tender_specification">
                                                <div style="font-size:14px; font-weight:bold; color:#1a1a1a; background:#f2f2f2; padding:4px 6px; margin-top:8px; margin-bottom:4px;">
                                                    Technical Specification
                                                </div>
                                                <div t-field="ol.tender_specification" style="font-size:13px; line-height:1.4;"/>
                                            </t>

                                        </td>

                                        <td style="text-align:center; vertical-align:top; font-size:13px; border:1px solid #ccc;">
                                            <span t-field="line.qty"/>
                                        </td>

                                        <td style="text-align:right; vertical-align:top; font-size:13px; border:1px solid #ccc;">
                                            <span t-field="line.unit_cnf_at_site"
                                                  t-options='{"widget":"float","precision":2}'/>
                                        </td>

                                        <td style="text-align:right; vertical-align:top; font-size:13px; border:1px solid #ccc;">
                                            <span t-field="line.total_cnf_at_site"
                                                  t-options='{"widget":"float","precision":2}'/>
                                        </td>
                                    </tr>
                                </t>

                                <!-- Grand Total -->

                                <tr style="background:#f2f2f2;">

                                    <td colspan="3" style="text-align:right; padding:8px; border:1px solid #ccc; font-size:14px;">
                                        <b>Grand Total</b>
                                    </td>

                                    <td style="text-align:right; padding:8px; border:1px solid #ccc; font-size:14px;">
                                        <strong>
                                            <span t-esc="sum(sale_order.worksheet_id.line_ids.mapped('unit_cnf_at_site'))"/>
                                        </strong>
                                    </td>

                                    <td style="text-align:right; padding:8px; border:1px solid #ccc; font-size:14px;">
                                        <strong>
                                            <span t-esc="sum(sale_order.worksheet_id.line_ids.mapped('total_cnf_at_site'))"/>
                                        </strong>
                                    </td>

                                </tr>

                            </tbody>

                        </table>

                        </t>

                        <!-- ================= TABLE : NORMAL VERSION (with GST) ================= -->

                        <t t-else="">

                        <table border="1"
                               style="width:100%;
                                      border-collapse:collapse;
                                      font-size:13px;
                                      border:1px solid #999;">

                            <thead>

                                <tr style="background:#1a1a1a;">

                                    <th style="width:5%; text-align:center; font-size:14px; font-weight:bold; color:#ffffff; padding:8px 4px;">
                                        S#
                                    </th>

                                    <th style="width:45%; text-align:center; font-size:14px; font-weight:bold; color:#ffffff; padding:8px 4px;">
                                        DESCRIPTION OF ITEMS
                                    </th>

                                    <th style="width:6%; text-align:center; font-size:14px; font-weight:bold; color:#ffffff; padding:8px 4px;">
                                        QTY
                                    </th>

                                    <th style="width:11%; text-align:center; font-size:14px; font-weight:bold; color:#ffffff; padding:8px 4px;">
                                        UNIT PRICE<br/>
                                        (EX GST)
                                    </th>

                                    <th style="width:11%; text-align:center; font-size:14px; font-weight:bold; color:#ffffff; padding:8px 4px;">
                                        TOTAL<br/>
                                        (EX GST)
                                    </th>

                                    <th style="width:10%; text-align:center; font-size:14px; font-weight:bold; color:#ffffff; padding:8px 4px;">
                                        GST
                                    </th>

                                    <th style="width:12%; text-align:center; font-size:14px; font-weight:bold; color:#ffffff; padding:8px 4px;">
                                        TOTAL<br/>
                                        (INC GST)
                                    </th>

                                </tr>

                            </thead>

                            <tbody>
                                <t t-set="order_lines" t-value="sale_order.order_line.filtered(lambda l: not l.display_type)"/>

                                <t t-foreach="sale_order.worksheet_id.line_ids" t-as="line">
                                    <t t-set="ol" t-value="order_lines.filtered(lambda l: l.product_id == line.product_id)[:1]"/>

                                    <tr>
                                        <td style="text-align:center; vertical-align:top; font-size:14px; font-weight:bold; border:1px solid #ccc;">
                                            <span t-field="line.sequence"/>
                                        </td>

                                        <td style="padding:10px; border:1px solid #ccc;">

                                            <div style="font-size:16px; font-weight:bold; color:#1a1a1a; margin-bottom:6px; text-decoration:underline;">
                                                <span t-field="line.product_id"/>
                                            </div>

                                            <table style="width:100%; border-collapse:collapse; margin-bottom:6px; border:1px solid #999;">
                                                <tr>
                                                    <td style="width:35%; font-size:13px; font-weight:bold; color:#444; padding:5px 8px; background:#f2f2f2; border:1px solid #999;">Model :</td>
                                                    <td style="font-size:13px; padding:5px 8px; border:1px solid #999;">
                                                        <span t-field="line.product_id.product_tmpl_id.model_no_id"/>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td style="width:35%; font-size:13px; font-weight:bold; color:#444; padding:5px 8px; background:#f2f2f2; border:1px solid #999;">Part No. :</td>
                                                    <td style="font-size:13px; padding:5px 8px; border:1px solid #999;">
                                                        <span t-field="line.product_id.product_tmpl_id.sku"/>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td style="width:35%; font-size:13px; font-weight:bold; color:#444; padding:5px 8px; background:#f2f2f2; border:1px solid #999;">Make :</td>
                                                    <td style="font-size:13px; padding:5px 8px; border:1px solid #999;">
                                                        <span t-field="line.product_id.product_tmpl_id.tender_make"/>
                                                    </td>
                                                </tr>
                                            </table>

                                            <t t-if="ol and ol.technical_key_features">
                                                <div style="font-size:14px; font-weight:bold; color:#1a1a1a; background:#f2f2f2; padding:4px 6px; margin-top:8px; margin-bottom:4px;">
                                                    Key Features
                                                </div>
                                                <div t-field="ol.technical_key_features" style="font-size:13px; line-height:1.4;"/>
                                            </t>

                                            <t t-if="ol and ol.tender_specification">
                                                <div style="font-size:14px; font-weight:bold; color:#1a1a1a; background:#f2f2f2; padding:4px 6px; margin-top:8px; margin-bottom:4px;">
                                                    Technical Specification
                                                </div>
                                                <div t-field="ol.tender_specification" style="font-size:13px; line-height:1.4;"/>
                                            </t>

                                        </td>

                                        <td style="text-align:center; vertical-align:top; font-size:13px; border:1px solid #ccc;">
                                            <span t-field="line.qty"/>
                                        </td>

                                        <td style="text-align:right; vertical-align:top; font-size:13px; border:1px solid #ccc;">
                                            <span t-field="line.unit_ex_gst_corrected"/>
                                        </td>

                                        <td style="text-align:right; vertical-align:top; font-size:13px; border:1px solid #ccc;">
                                            <span t-field="line.total_ex_gst"/>
                                        </td>

                                        <td style="text-align:right; vertical-align:top; font-size:13px; border:1px solid #ccc;">
                                            <span t-field="line.gst_amount"/>
                                        </td>

                                        <td style="text-align:right; vertical-align:top; font-size:13px; border:1px solid #ccc;">
                                            <span t-field="line.total_inc_gst"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>

                        </table>

                        </t>

                        <br/><br/>

                        <!-- ================= GRAND TOTAL SUMMARY ================= -->

                        <t t-if="is_cnf">

                        <t t-set="grand_total_cnf"
                           t-value="sum(sale_order.worksheet_id.line_ids.mapped('total_cnf_at_site'))"/>

                        <table style="width:100%; margin-top:10px; border-collapse:collapse; font-size:13px;"
                               border="1">

                            <tr style="background:#f2f2f2;">

                                <td style="width:76%; border:none;"></td>

                                <td style="width:24%; text-align:right; padding:8px; border:1px solid #ccc;">
                                    <b>Grand Total</b>
                                </td>

                                <td style="text-align:right; padding:8px; border:1px solid #ccc;">
                                    <b>
                                        <span t-esc="grand_total_cnf"/>
                                    </b>
                                </td>

                            </tr>

                        </table>

                        </t>

                        <t t-else="">

                        <t t-set="grand_ex_gst"
                           t-value="sum(sale_order.worksheet_id.line_ids.mapped('total_ex_gst'))"/>

                        <t t-set="grand_gst"
                           t-value="sum(sale_order.worksheet_id.line_ids.mapped('gst_amount'))"/>

                        <t t-set="grand_total"
                           t-value="sum(sale_order.worksheet_id.line_ids.mapped('total_inc_gst'))"/>

                        <table style="width:100%; margin-top:10px; border-collapse:collapse; font-size:13px;"
                               border="1">

                            <tr>

                                <td style="width:56%; border:none;"></td>

                                <td style="width:20%; text-align:right; padding:8px; border:1px solid #ccc;">
                                    <b>Total Ex GST</b>
                                </td>

                                <td style="width:24%; text-align:right; padding:8px; border:1px solid #ccc;">
                                    <span t-esc="grand_ex_gst"/>
                                </td>

                            </tr>

                            <tr>

                                <td style="border:none;"></td>

                                <td style="text-align:right; padding:8px; border:1px solid #ccc;">
                                    <b>GST @18%</b>
                                </td>

                                <td style="text-align:right; padding:8px; border:1px solid #ccc;">
                                    <span t-esc="grand_gst"/>
                                </td>

                            </tr>

                            <tr style="background:#f2f2f2;">

                                <td style="border:none;"></td>

                                <td style="text-align:right; padding:8px; border:1px solid #ccc;">
                                    <b>Grand Total</b>
                                </td>

                                <td style="text-align:right; padding:8px; border:1px solid #ccc;">
                                    <b>
                                        <span t-esc="grand_total"/>
                                    </b>
                                </td>

                            </tr>

                        </table>

                        </t>

                        <br/><br/>

                        <t t-if="sale_order and sale_order.techno_financial_terms">

                            <div style="text-align:center; background:#1a1a1a; padding:6px 0; margin-bottom:10px;">
                                <h4 style="font-weight:bold; font-size:16px; color:#ffffff; letter-spacing:0.5px; margin:0;">
                                    TERMS &amp; CONDITIONS
                                </h4>
                            </div>

                            <div t-field="sale_order.techno_financial_terms" style="font-size:13px; line-height:1.5;"/>

                        </t>

                    </div>

                </t>

            </t>

        </t>

    </template>

</odoo>