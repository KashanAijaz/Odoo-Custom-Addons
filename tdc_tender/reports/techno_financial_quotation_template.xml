<?xml version="1.0" encoding="utf-8"?>
<odoo>

        <template id="report_techno_financial_quotation">

        <t t-call="web.html_container">

        <t t-foreach="docs" t-as="doc">

        <t t-call="web.external_layout">

        <t t-set="sale_order" t-value="doc.sale_order_ids[:1]"/>

        <div class="page">

        <!-- ================= HEADER ================= -->

        <table style="width:100%;font-size:13px;border-collapse:collapse;">

        <tr>

        <td style="width:60%;vertical-align:top;">

        <b>Attn.</b><br/>

        <span t-esc="doc.upcoming_tender_id.partner_id.name"/>

        </td>

        <td style="width:40%;">

        <table style="width:100%;">

        <tr>
        <td><b>Date</b></td>
        <td>
        <span t-field="doc.create_date"
        t-options='{"widget":"date"}'/>
        </td>
        </tr>

        <tr>
        <td><b>Validity</b></td>
        <td>120 Days</td>
        </tr>

        <tr>
        <td><b>Quote No.</b></td>
        <td>
        <span t-field="sale_order.name"/>
        </td>
        </tr>

        <tr>
        <td><b>Reference</b></td>
        <td>
        <span t-esc="doc.upcoming_tender_id.tender_title"/>
        </td>
        </tr>

        </table>

        </td>

        </tr>

        </table>

        <br/>

        <div style="border-top:2px solid #000;border-bottom:2px solid #000;padding:8px;text-align:center;">

        <h3 style="margin:0;">
        TECHNO FINANCIAL QUOTATION
        </h3>

        </div>

        <br/>

        <p>

        Dear Sir,

        <br/><br/>

        We thank you for providing us the opportunity to participate in your tender.
        We are pleased to submit our Techno Financial Quotation as under.

        </p>

        <br/>

        <table border="1"
        style="width:100%;
        border-collapse:collapse;
        font-size:11px;">

        <thead>

        <tr style="background:#D9EAD3;">

        <th style="width:5%;text-align:center;">
        S#
        </th>

        <th style="width:45%;text-align:center;">
        DESCRIPTION OF ITEMS
        </th>

        <th style="width:6%;text-align:center;">
        QTY
        </th>

        <th style="width:11%;text-align:center;">
        UNIT PRICE
        (EX GST)
        </th>

        <th style="width:11%;text-align:center;">
        TOTAL
        (EX GST)
        </th>

        <th style="width:10%;text-align:center;">
        GST
        </th>

        <th style="width:12%;text-align:center;">
        TOTAL
        (INC GST)
        </th>

        </tr>

        </thead>

        <tbody>

        <t t-foreach="doc.worksheet_ids.line_ids" t-as="line">

        <tr>

        <td style="vertical-align:top;text-align:center;">

        <span t-field="line.sequence"/>

        </td>

        <td style="padding:8px;">

        <strong>

        <span t-field="line.product_id"/>

        </strong>

        <br/><br/>

        <b>MODEL :</b>

        <span t-field="line.product_id.product_tmpl_id.model_no_id"/>

        <br/>

        <b>MAKE :</b>

        <span t-field="line.product_id.product_tmpl_id.tender_make"/>

        <br/><br/>

        <b>TECHNICAL SPECIFICATION</b>

        <br/><br/>

      <div t-field="line.sale_line_id.technical_key_features"/>
        
    

        </td>

        <td style="text-align:center;vertical-align:top;">

        <span t-field="line.qty"/>

        </td>

        <td style="text-align:right;vertical-align:top;">

        <span t-field="line.unit_ex_gst_corrected"/>

        </td>

        <td style="text-align:right;vertical-align:top;">

        <span t-field="line.total_ex_gst"/>

        </td>

        <td style="text-align:right;vertical-align:top;">

        <span t-field="line.gst_amount"/>

        </td>

        <td style="text-align:right;vertical-align:top;">

        <span t-field="line.total_inc_gst"/>

        </td>

        </tr>

        </t>

        </tbody>

        </table>

        <br/><br/>

                                <!-- ================= GRAND TOTAL ================= -->

                                <t t-set="grand_ex_gst"
                                t-value="sum(doc.worksheet_ids.line_ids.mapped('total_ex_gst'))"/>

                                <t t-set="grand_gst"
                                t-value="sum(doc.worksheet_ids.line_ids.mapped('gst_amount'))"/>

                                <t t-set="grand_total"
                                t-value="sum(doc.worksheet_ids.line_ids.mapped('total_inc_gst'))"/>

                                <table style="width:100%;
                                            margin-top:10px;
                                            border-collapse:collapse;"
                                    border="1">

                                    <tr>

                                        <td style="width:56%;border:none;"></td>

                                        <td style="width:20%;text-align:right;">
                                            <b>Total Ex GST</b>
                                        </td>

                                        <td style="width:24%;text-align:right;">
                                            <span t-esc="grand_ex_gst"/>
                                        </td>

                                    </tr>

                                    <tr>

                                        <td style="border:none;"></td>

                                        <td style="text-align:right;">
                                            <b>GST @18%</b>
                                        </td>

                                        <td style="text-align:right;">
                                            <span t-esc="grand_gst"/>
                                        </td>

                                    </tr>

                                    <tr style="background:#D9EAD3;">

                                        <td style="border:none;"></td>

                                        <td style="text-align:right;">
                                            <b>Grand Total</b>
                                        </td>

                                        <td style="text-align:right;">
                                            <b>
                                                <span t-esc="grand_total"/>
                                            </b>
                                        </td>

                                    </tr>

                                </table>

                                <br/><br/>

                                <t t-if="sale_order and sale_order.techno_financial_terms">

                                    <h4>
                                        TERMS &amp; CONDITIONS
                                    </h4>

                                    <div t-field="sale_order.techno_financial_terms"/>

                                </t>

                                <br/><br/>

                                <!-- <table style="width:100%;">

                                    <tr>

                                        <td style="width:60%;">

                                            <b>
                                                <span t-field="doc.company_id.name"/>
                                            </b>

                                            <br/>

                                            <span t-field="doc.company_id.street"/>

                                            <br/>

                                            <span t-field="doc.company_id.city"/>

                                            <br/>

                                            <strong>Phone :</strong>

                                            <span t-field="doc.company_id.phone"/>

                                            <br/>

                                            <strong>Email :</strong>

                                            <span t-field="doc.company_id.email"/>

                                            <br/>

                                            <strong>Website :</strong>

                                            <span t-field="doc.company_id.website"/>

                                        </td>

                                        <td style="width:40%;
                                                text-align:center;
                                                vertical-align:bottom;">

                                            <br/><br/><br/><br/>

                                            _______________________

                                            <br/>

                                            <b>Authorized Signature</b>

                                        </td>

                                    </tr>

                                </table> -->

                            </div>

                        </t>

                    </t>

                </t>

            </template>
</odoo>