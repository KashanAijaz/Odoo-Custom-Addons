                                </td>

                                <td style="width:40%;text-align:center;vertical-align:bottom;">

                                    <br/><br/><br/><br/><br/>

                                    ___________________________

                                    <br/>

                                    <strong>Authorized Signature</strong>

                                </td>

                            </tr>

                        </table> -->

                    </div>

                </t>

            </t>

        </t>

    </template>

</odoo>