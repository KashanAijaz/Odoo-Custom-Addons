<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View -->

    <record id="view_tdc_organization_tree" model="ir.ui.view">
        <field name="name">tdc.organization.tree</field>
        <field name="model">tdc.organization</field>
        <field name="arch" type="xml">
            <list>

                <field name="name"/>
                <field name="partner_id"/>


                <field name="phone"/>

                <field name="email"/>

                <field name="website"/>

            </list>
        </field>
    </record>


    <!-- Form View -->

    <record id="view_tdc_organization_form" model="ir.ui.view">
        <field name="name">tdc.organization.form</field>
        <field name="model">tdc.organization</field>
        <field name="arch" type="xml">

            <form>

                <sheet>

                    <group>

                        <field name="name"/>
                        <field name="partner_id"/>

                        <field name="phone"/>

                        <field name="email"/>

                        <field name="website"/>

                        <field name="address"/>

                        <field name="active"/>

                    </group>

                </sheet>

            </form>

        </field>
    </record>


    <!-- Action -->

    <record id="action_tdc_organization"
            model="ir.actions.act_window">

        <field name="name">Organizations</field>

        <field name="res_model">tdc.organization</field>

        <field name="view_mode">list,form</field>

    </record>

</odoo>