<odoo>

    <record id="view_tdc_tender_create_so_wizard_form" model="ir.ui.view">
        <field name="name">tdc.tender.create.so.wizard.form</field>
        <field name="model">tdc.tender.create.so.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="tender_id" invisible="1"/>
                <field name="line_ids">
                    <list editable="bottom" create="0" delete="0">
                        <field name="worksheet_id" readonly="1"/>
                        <field name="existing_count" readonly="1"/>
                        <field name="so_count"/>
                    </list>
                </field>
                <footer>
                    <button string="Create Sale Orders" type="object"
                            name="action_confirm" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>