<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==========================================================
                            TREE VIEW
    =========================================================== -->

    <record id="view_tdc_instrument_tree" model="ir.ui.view">
        <field name="name">tdc.instruments.tree</field>
        <field name="model">tdc.instruments</field>
        <field name="arch" type="xml">
            <list string="Instruments">

                <field name="instrument_name"/>

                <field name="details"/>

                <field name="active"/>

            </list>
        </field>
    </record>


    <!-- ==========================================================
                            FORM VIEW
    =========================================================== -->

    <record id="view_tdc_instrument_form" model="ir.ui.view">
        <field name="name">tdc.instruments.form</field>
        <field name="model">tdc.instruments</field>
        <field name="arch" type="xml">

            <form string="Instrument">

                <sheet>

                    <group>

                        <field name="instrument_name"/>

                        <field name="details"/>

                        <field name="active"/>

                    </group>

                </sheet>

            </form>

        </field>
    </record>


    <!-- ==========================================================
                            ACTION
    =========================================================== -->

    <record id="action_tdc_instruments"
            model="ir.actions.act_window">

        <field name="name">Instruments</field>

        <field name="res_model">tdc.instruments</field>

        <field name="view_mode">list,form</field>

    </record>


    <!-- ==========================================================
                            MENU
    =========================================================== -->

    

</odoo>