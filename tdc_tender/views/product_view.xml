<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_tender" model="ir.ui.view">
        <field name="name">product.template.form.tender</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>

        <field name="arch" type="xml">

        <xpath expr="//field[@name='categ_id']" position="after">
             
                <field name="tender_make"/>
                <field name="country_of_origin"/>
             
            </xpath>

            <xpath expr="//page[@name='general_information']" position="inside">

                <separator string="Enter Details"/>

                <separator string="Key Features"/>
                <field
                    name="technical_key_features"
                    widget="html"
                />

                <separator string="Technical Specification"/>
                <field
                    name="tender_specification"
                    widget="html"
                />

                <separator string="Power Supply"/>
                <field
                    name="technical_power_supply"
                    widget="html"
                />

            </xpath>

        </field>

    </record>

</odoo>