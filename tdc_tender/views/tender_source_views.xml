<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree -->

    <record id="view_tdc_tender_source_tree"
            model="ir.ui.view">

        <field name="name">tdc.tender.source.tree</field>
        <field name="model">tdc.tender.source</field>

        <field name="arch" type="xml">

            <list>

                <!-- <field name="sequence" i/> -->

                <field name="name"/>

                <field name="website"/>

                <field name="email"/>

                <field name="phone"/>

                <field name="active"/>

            </list>

        </field>

    </record>

    <!-- Form -->

    <record id="view_tdc_tender_source_form"
            model="ir.ui.view">

        <field name="name">tdc.tender.source.form</field>

        <field name="model">tdc.tender.source</field>

        <field name="arch" type="xml">

            <form>

                <form>

            <sheet>

                <group>

                    <group>

                        <!-- <field name="sequence"/> -->
                        <field name="name"/>
                        <field name="website"/>
                        <field name="email"/>

                    </group>

                    <group>

                        <!-- <field name="phone"/>
                        <field name="contact_person"/> -->
                        <field name="active"/>

                    </group>

                </group>

                <notebook>

                    <page string="Address">

                        <field name="address"/>

                    </page>

                    <page string="Remarks">

                        <field name="remarks"/>

                    </page>

                </notebook>

            </sheet>

        </form>

            </form>

        </field>

    </record>

    <!-- Action -->

    <record id="action_tdc_tender_source"
            model="ir.actions.act_window">

        <field name="name">Tender Sources</field>

        <field name="res_model">tdc.tender.source</field>

        <field name="view_mode">list,form</field>

    </record>

    <!-- Menu -->

    

</odoo>