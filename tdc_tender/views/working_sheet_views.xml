<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <!-- ===========================================================
                            TREE VIEW
    ============================================================ -->

    <record id="view_working_sheet_tree" model="ir.ui.view">
        <field name="name">tdc.working.sheet.tree</field>
        <field name="model">tdc.working.sheet</field>
        <field name="arch" type="xml">
            <list string="Working Sheets">

                <field name="name"/>
                <field name="project_ids" widget="many2many_tags"/>

            </list>
        </field>
    </record>


    <!-- ===========================================================
                            FORM VIEW
    ============================================================ -->

    <record id="view_working_sheet_form" model="ir.ui.view">
        <field name="name">tdc.working.sheet.form</field>
        <field name="model">tdc.working.sheet</field>
        <field name="arch" type="xml">

            <form string="Working Sheet">

                <sheet>

                    <group>
                        <field name="name" readonly="1"/>
                          <field name="project_ids" widget="many2many_tags"/>
                           <field name="tender_titles"
                               readonly="1"/>

                        <field name="tender_items"
                               readonly="1"/>

                                  <field name="incoterm_id"
           readonly="1"/>
                    </group>
                    <group>
                        <field name="currency_id"/>
                        <field name="currency_rate"/>
                         <field name="is_cnf"/>
                    </group>
                    <notebook>

                        <page string="Working Sheet">

                            <field name="line_ids">

                                <list editable="bottom">

                                    <field name="sequence" string="SNo."/>

                                    <field name="qty"/>

                                    <field name="product_id"/>

                                    <field name="model_no_id"/>
                                    <field name="custom_currency_rate"/>
                                    
                                    <field name="currency_rate" readonly="not custom_currency_rate"/>
                                    <field name="currency_id"/>

                                    <field name="list_price"/>

                                    <field name="discount_margin"/>

                                    <field name="net_discount_price" readonly="0"/>

                                    <field name="freight_per_unit"/>

                                    <field name="factor"/>

                                    <!-- Regular Fields - Visible only if is_cnf is NOT checked -->
                                    <!-- Make parent field available -->
                                    <field name="is_cnf" column_invisible="True" force_save="1"/>

                                    <!-- NORMAL COSTING -->
                                    <field name="tax_duty"
                                        column_invisible="parent.is_cnf" force_save="1"/>

                                    <field name="unit_ex_gst_corrected"
                                        column_invisible="parent.is_cnf" force_save="1"/>

                                    <field name="total_ex_gst"
                                        column_invisible="parent.is_cnf" force_save="1"/>

                                    <field name="gst_amount"
                                        column_invisible="parent.is_cnf" force_save="1"/>

                                    <field name="total_inc_gst"
                                        column_invisible="parent.is_cnf" force_save="1"/>

                                    <!-- C&F COSTING -->
                                    <field name="unit_cnf_without_taxes"
                                        column_invisible="not parent.is_cnf" force_save="1"/>

                                    <field name="total_cnf_without_taxes"
                                        column_invisible="not parent.is_cnf" force_save="1"/>

                                    <field name="custom_duties_taxes_caa"
                                        column_invisible="not parent.is_cnf" force_save="1"/>
                                    
                                    <field name="custom_duty_percent"
                                        column_invisible="not parent.is_cnf" force_save="1"/>

                                     <field name="local_transport_percent"
                                        column_invisible="not parent.is_cnf" force_save="1"/>
                                        

                                    <field name="local_transport_clearance"
                                        column_invisible="not parent.is_cnf" force_save="1" readonly="True"/>
                                    <field name="unit_cnf_at_site"  column_invisible="not parent.is_cnf" force_save="1"/>
                                    <field name="total_cnf_at_site"
                                        column_invisible="not parent.is_cnf" force_save="1" />

                                </list>

                            </field>

                        </page>

                    </notebook>

                </sheet>

            </form>

        </field>
    </record>


    <!-- ===========================================================
                            ACTION
    ============================================================ -->

    <record id="action_working_sheet" model="ir.actions.act_window">
        <field name="name">Working Sheet</field>
        <field name="res_model">tdc.working.sheet</field>
        <field name="view_mode">list,form</field>
    </record>


    <!-- ===========================================================
                            MENUS
    ============================================================ -->

    <menuitem
        id="menu_tdc_root"
        name="Tender Management"
        web_icon="tdc_tender,static/description/icon.png"
        sequence="10"/>

      <!-- Upcoming Tender -->

    <menuitem
        id="menu_upcoming_tender"
        name="Upcoming Tenders"
        parent="menu_tdc_root"
        action="action_upcoming_tender"
        sequence="1"/>

    <menuitem
        id="menu_working_sheet"
        name="Working Sheet"
        parent="menu_tdc_root"
        action="action_working_sheet"
        sequence="2"/>

     <menuitem
        id="menu_tdc_tender"
        name="Tenders"
        parent="menu_tdc_root"
        action="action_tdc_tender"
        sequence="3"/>

       <menuitem
        id="menu_tdc_earnest_money"
        name="Earnest Money"
        parent="menu_tdc_root"
        action="action_tdc_earnest_money"
        sequence="4"
      
    />
        <menuitem
            id="menu_tdc_performance_bond"
            name="Performance Bond"
            parent="menu_tdc_root"
            action="action_tdc_performance_bond"
            sequence="5"
           
    />

   





    <!-- Configuration -->

    <menuitem
        id="menu_tender_configuration"
        name="Configuration"
        parent="menu_tdc_root"
        sequence="100"/>


    <!-- Organization -->

    <menuitem
        id="menu_organization"
        name="Organizations"
        parent="menu_tender_configuration"
        action="action_tdc_organization"
        sequence="1"/>

    <menuitem
        id="menu_tdc_instruments"
        name="Instruments"
        parent="menu_tender_configuration"
        action="action_tdc_instruments"
        sequence="2"/>

     <menuitem
        id="menu_tdc_payment_method"
        name="Payment Methods"
        parent="menu_tender_configuration"
        action="action_tdc_payment_method"
        sequence="4"/>
    
    <menuitem
        id="menu_tdc_tender_source"
        name="Tender Sources"
        parent="menu_tender_configuration"
        action="action_tdc_tender_source"
        sequence="5"/> 
    
    <menuitem id="menu_tdc_incoterms"
          name="Incoterms"
          parent="menu_tender_configuration"
          action="action_tdc_incoterms"
          sequence="6"/>
          
</odoo>