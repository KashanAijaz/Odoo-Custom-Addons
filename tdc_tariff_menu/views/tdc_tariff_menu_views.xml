    <!-- Action -->
    <record id="tdc_tariff_menu_action" model="ir.actions.act_window">
        <field name="name">Tariff Menu</field>
        <field name="res_model">tdc.tariff.menu</field>
        <field name="view_mode">list,form</field>
       
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Tariff Menu
            </p>
        </field>
    </record>

    <!-- Top level menu -->
    <menuitem id="tdc_tariff_root_menu"
              name="Tariff Menu"
              sequence="60"/>

    <menuitem id="tdc_tariff_menu_menu"
              name="Tariff Menu"
              parent="tdc_tariff_root_menu"
              action="tdc_tariff_menu_action"
              sequence="10"/>

</odoo>
