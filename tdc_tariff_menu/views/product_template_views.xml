<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_view_inherit_tdc" model="ir.ui.view">
        <field name="name">product.template.form.inherit.tdc</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Tariff Info" name="tdc_tariff_info">
                    <group>
                        <field name="tdc_hs_code" placeholder="e.g. 8471.3000"/>
                        <field name="tdc_cd" placeholder="0.00"/>
                        <field name="tdc_acd" placeholder="0.00"/>
                        <field name="tdc_rd" placeholder="0.00"/>
                    </group>
                </page>
            </notebook>
        </field>
    </record>

</odoo>
