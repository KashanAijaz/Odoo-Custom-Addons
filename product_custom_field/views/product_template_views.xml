<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record id="view_product_form_custom" model="ir.ui.view">
        <field name="name">product.template.form.custom</field>
        <field name="model">product.template</field>

        <field name="inherit_id" ref="product.product_template_only_form_view"/>

        <field name="arch" type="xml">

            <xpath expr="//page[@name='general_information']/group" position="inside">

                <group string="Additional Information">

                    <field name="manufacturer_name"/>

                    <field name="warranty_period"/>

                    <field name="is_returnable"/>

                    <field name="launch_date"/>

                </group>


            </xpath>
            <xpath expr="//field[@name='barcode']" position="after">
                <field name="default_code"/>
                
            </xpath>

        </field>

    </record>

</odoo>