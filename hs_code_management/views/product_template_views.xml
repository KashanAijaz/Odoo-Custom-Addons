<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="product_template_form_custom" model="ir.ui.view">
        <field name="name">product.template.form.custom</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='type']" position="attributes">
                <attribute name="selection">[('consu', 'Goods'), ('service', 'Service')]</attribute>
            </xpath>

             <xpath expr="//field[@name='name']" position="attributes">
                        <attribute name="placeholder">Enter Product Name</attribute>
                    </xpath>

            <!-- Add fields after Barcode -->
            <xpath expr="//field[@name='barcode']" position="after">
                <field name="sku" invisible="type != 'consu'"/>
                <!-- <field name="brand_id" invisible="type != 'consu'"/> -->
                <field name="expiry" invisible="type != 'consu' or not is_perishable"/> 
                <field name="expiry_date" invisible="type != 'consu' or not expiry"/>
                <field name="days_to_expire" invisible="type != 'consu' or not expiry" readonly="1"/>
                <field name="model_no_id" invisible="type != 'consu'"/>
                <field name="serial_no_id" invisible="type != 'consu'"/>
                
              
                
            </xpath>
           

        </field>
    </record>
    <record id="product_template_form_view_perishable" model="ir.ui.view">
    <field name="name">product.template.form.perishable</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_only_form_view"/>
    <field name="arch" type="xml">
        <field name="type" position="after">
            <field name="is_perishable" invisible="type != 'consu'"/>
        </field>
    </field>
</record>
<record id="stock_product_product_tree_days_to_expire" model="ir.ui.view">
    <field name="name">stock.product.product.tree.days.to.expire</field>
    <field name="model">product.product</field>
    <field name="inherit_id" ref="stock.product_product_stock_tree"/>
    <field name="arch" type="xml">
        <xpath expr="//field[@name='display_name']" position="after">
            <field name="days_to_expire" optional="show"/>
        </xpath>
    </field>
</record>

</odoo>