<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_partner_form_inherit_vendor_type" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.vendor.type</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <!-- Show only for Vendors -->
            <xpath expr="//field[@name='property_product_pricelist']" position="after">
                <field name="x_vendor_type"/>
            </xpath>

        </field>
    </record>

</odoo>