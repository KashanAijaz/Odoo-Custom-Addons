<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_order_form_view_hs_code" model="ir.ui.view">
        <field name="name">sale.order.form.hs.code</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']//field[@name='product_template_id']" position="after">
                <field name="hs_code_id" optional="show"/>
                <field name="model_no_id" optional="show" invisible="not model_no_id"/>
                <field name="serial_no_id" optional="show" invisible="not serial_no_id"/>
            </xpath>
        </field>
    </record>

</odoo>