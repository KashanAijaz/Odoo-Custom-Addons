<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View -->
    <record id="hs_code_view_list" model="ir.ui.view">
        <field name="name">hs.code.list</field>
        <field name="model">hs.code</field>
        <field name="arch" type="xml">
            <list string="HS Codes">
                <field name="code"/>
                <field name="description"/>
                <field name="cd_percentage"/>
                <field name="rd_percentage"/>
                <field name="acd_percentage"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="hs_code_view_form" model="ir.ui.view">
        <field name="name">hs.code.form</field>
        <field name="model">hs.code</field>
        <field name="arch" type="xml">
            <form string="HS Code">
                <sheet>

                    <div class="oe_title">
                        <h1>
                            <field name="code" placeholder="1000.2000"/>
                        </h1>
                    </div>

                    <group>

                        <group string="General Information">
                            <field name="description"/>
                            <field name="active" invisible="1"/>
                        </group>

                        <group string="Duty Percentage">
                            <field name="cd_percentage"/>
                            <field name="rd_percentage"/>
                            <field name="acd_percentage"/>
                        </group>

                    </group>

                    <group string="Chart of Accounts">

                        <group>
                            <field name="cd_account_id"/>
                            <field name="rd_account_id"/>
                            <field name="acd_account_id"/>
                        </group>
                        <group string="Tax Accounts">
                             <field name="st_id"/>
                            <field name="ast_id"/>
                            <field name="it_id"/>
                        </group>

                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="hs_code_view_search" model="ir.ui.view">
        <field name="name">hs.code.search</field>
        <field name="model">hs.code</field>
        <field name="arch" type="xml">
            <search string="HS Codes">
                <field name="code"/>
                <field name="description"/>

                <separator/>

                <filter string="Active"
                        name="active"
                        domain="[('active','=',True)]"/>

                <filter string="Archived"
                        name="archived"
                        domain="[('active','=',False)]"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="hs_code_action" model="ir.actions.act_window">
        <field name="name">HS Codes</field>
        <field name="res_model">hs.code</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first HS Code.
            </p>
        </field>
    </record>

    <!-- Menu -->
    <menuitem id="hs_code_menu"
              name="HS Codes"
              parent="purchase.menu_purchase_config"
              action="hs_code_action"
              sequence="60"/>
</odoo>