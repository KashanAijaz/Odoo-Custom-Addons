<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Product Template Form -->
    <record id="product_template_form_view_hs_code" model="ir.ui.view">
        <field name="name">product.template.form.hs.code</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="hs_code_id" invisible="type!='consu'"/>
                
            </xpath>
        </field>
    </record>

    <!-- Product Variant Form (product.product) -->
    <record id="product_normal_form_view_hs_code" model="ir.ui.view">
        <field name="name">product.product.form.hs.code</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="hs_code_id" />
                <field name="model_no_id"/>
                <field name="serial_no_id"/>
            </xpath>

            
             <xpath expr="//field[@name='name']" position="attributes">
                        <attribute name="placeholder">Enter Product Name</attribute>
                </xpath>
        </field>
    </record>

</odoo>
